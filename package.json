{
  "name": "nidhish-jarvis",
  "displayName": "Nidhish's Jarvis",
  "description": "A modular AI productivity platform for VS Code with conversation memory, planning, writing, coding, and plugin-ready extensibility.",
  "version": "0.1.2",
  "publisher": "NidhishKumaran",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nidhishmanimaran-rgb/nidhish-jarvis.git"
  },
  "homepage": "https://github.com/nidhishmanimaran-rgb/nidhish-jarvis",
  "bugs": {
    "url": "https://github.com/nidhishmanimaran-rgb/nidhish-jarvis/issues"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "jarvis",
    "ollama",
    "assistant",
    "chat",
    "developer",
    "llm",
    "productivity",
    "coding"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nidhish-jarvis.openAssistant",
        "title": "Jarvis: Open Assistant",
        "icon": "$(hubot)"
      },
      {
        "command": "nidhish-jarvis.newChat",
        "title": "Jarvis: New Chat",
        "icon": "$(comment-add)"
      },
      {
        "command": "nidhish-jarvis.clearChat",
        "title": "Jarvis: Clear Chat",
        "icon": "$(clear-all)"
      },
      {
        "command": "nidhish-jarvis.exportHistory",
        "title": "Jarvis: Export Conversation",
        "icon": "$(export)"
      },
      {
        "command": "nidhish-jarvis.showStatus",
        "title": "Jarvis: Show Status",
        "icon": "$(pulse)"
      },
      {
        "command": "nidhish-jarvis.openSettings",
        "title": "Jarvis: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nidhish-jarvis.indexWorkspace",
        "title": "Jarvis: Index Workspace",
        "icon": "$(database)"
      },
      {
        "command": "nidhish-jarvis.reindexWorkspace",
        "title": "Jarvis: Reindex Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "nidhish-jarvis.explainProject",
        "title": "Jarvis: Explain Project",
        "icon": "$(project)"
      },
      {
        "command": "nidhish-jarvis.searchWorkspace",
        "title": "Jarvis: Search Workspace",
        "icon": "$(search)"
      },
      {
        "command": "nidhish-jarvis.findSymbol",
        "title": "Jarvis: Find Symbol",
        "icon": "$(symbol-method)"
      },
      {
        "command": "nidhish-jarvis.explainSymbol",
        "title": "Jarvis: Explain Symbol",
        "icon": "$(symbol-key)"
      },
      {
        "command": "nidhish-jarvis.findReferences",
        "title": "Jarvis: Find References",
        "icon": "$(references)"
      },
      {
        "command": "nidhish-jarvis.explainSelection",
        "title": "Jarvis: Explain Selection",
        "icon": "$(selection)"
      },
      {
        "command": "nidhish-jarvis.fixSelection",
        "title": "Jarvis: Fix Selection",
        "icon": "$(wrench)"
      },
      {
        "command": "nidhish-jarvis.refactorSelection",
        "title": "Jarvis: Refactor Selection",
        "icon": "$(tools)"
      },
      {
        "command": "nidhish-jarvis.optimizeSelection",
        "title": "Jarvis: Optimize Selection",
        "icon": "$(rocket)"
      },
      {
        "command": "nidhish-jarvis.generateTests",
        "title": "Jarvis: Generate Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "nidhish-jarvis.generateDocumentation",
        "title": "Jarvis: Generate Documentation",
        "icon": "$(book)"
      },
      {
        "command": "nidhish-jarvis.reviewCode",
        "title": "Jarvis: Review Code",
        "icon": "$(checklist)"
      },
      {
        "command": "nidhish-jarvis.renameAcrossProject",
        "title": "Jarvis: Rename Across Project",
        "icon": "$(replace-all)"
      },
      {
        "command": "nidhish-jarvis.updateImports",
        "title": "Jarvis: Update Imports",
        "icon": "$(sync)"
      },
      {
        "command": "nidhish-jarvis.explainError",
        "title": "Jarvis: Explain Error",
        "icon": "$(error)"
      },
      {
        "command": "nidhish-jarvis.fixError",
        "title": "Jarvis: Fix Error",
        "icon": "$(debug)"
      },
      {
        "command": "nidhish-jarvis.analyzeProblems",
        "title": "Jarvis: Analyze Problems",
        "icon": "$(issues)"
      },
      {
        "command": "nidhish-jarvis.explainTerminalOutput",
        "title": "Jarvis: Explain Terminal Output",
        "icon": "$(terminal)"
      },
      {
        "command": "nidhish-jarvis.runApprovedCommand",
        "title": "Jarvis: Run Approved Command",
        "icon": "$(play)"
      },
      {
        "command": "nidhish-jarvis.explainGitChanges",
        "title": "Jarvis: Explain Git Changes",
        "icon": "$(git-branch)"
      },
      {
        "command": "nidhish-jarvis.generateCommitMessage",
        "title": "Jarvis: Generate Commit Message",
        "icon": "$(git-commit)"
      },
      {
        "command": "nidhish-jarvis.showGitStatus",
        "title": "Jarvis: Show Git Status",
        "icon": "$(source-control)"
      },
      {
        "command": "nidhish-jarvis.rememberProjectFact",
        "title": "Jarvis: Remember Project Fact",
        "icon": "$(archive)"
      },
      {
        "command": "nidhish-jarvis.searchMemory",
        "title": "Jarvis: Search Memory",
        "icon": "$(search)"
      },
      {
        "command": "nidhish-jarvis.clearMemory",
        "title": "Jarvis: Clear Memory",
        "icon": "$(trash)"
      },
      {
        "command": "nidhish-jarvis.runAgent",
        "title": "Jarvis: Run Agent",
        "icon": "$(debug)"
      },
      {
        "command": "nidhish-jarvis.addApiKey",
        "title": "Jarvis: Add API Key",
        "icon": "$(key)"
      },
      {
        "command": "nidhish-jarvis.removeApiKey",
        "title": "Jarvis: Remove API Key",
        "icon": "$(key)"
      },
      {
        "command": "nidhish-jarvis.testProvider",
        "title": "Jarvis: Test Provider Connection",
        "icon": "$(plug)"
      },
      {
        "command": "nidhish-jarvis.openFoundationPanel",
        "title": "Jarvis: Open Foundation Panel",
        "icon": "$(layout)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nidhish-jarvis",
          "title": "Nidhish's Jarvis",
          "icon": "media/jarvis-activity.svg"
        }
      ]
    },
    "views": {
      "nidhish-jarvis": [
        {
          "id": "nidhish-jarvis.views.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "nidhish-jarvis.views.workspace",
          "name": "Workspace",
          "type": "webview"
        },
        {
          "id": "nidhish-jarvis.views.search",
          "name": "Search",
          "type": "webview"
        },
        {
          "id": "nidhish-jarvis.views.files",
          "name": "Files",
          "type": "webview"
        },
        {
          "id": "nidhish-jarvis.views.memory",
          "name": "Memory",
          "type": "webview"
        },
        {
          "id": "nidhish-jarvis.views.agents",
          "name": "Agents",
          "type": "webview"
        },
        {
          "id": "nidhish-jarvis.views.git",
          "name": "Git",
          "type": "webview"
        },
        {
          "id": "nidhish-jarvis.views.terminal",
          "name": "Terminal",
          "type": "webview"
        },
        {
          "id": "nidhish-jarvis.views.models",
          "name": "Models",
          "type": "webview"
        },
        {
          "id": "nidhish-jarvis.views.settings",
          "name": "Settings",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Jarvis",
      "properties": {
        "jarvis.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai",
            "openrouter",
            "azureOpenai",
            "custom"
          ],
          "default": "ollama",
          "description": "Selected AI provider. Ollama is the default provider when available."
        },
        "jarvis.model": {
          "type": "string",
          "enum": [
            "qwen2.5-coder:3b",
            "qwen2.5-coder:latest",
            "llama3.2:3b",
            "mistral:7b",
            "deepseek-r1:8b"
          ],
          "default": "qwen2.5-coder:3b",
          "description": "Preferred Ollama model or provider-specific profile."
        },
        "jarvis.ollama.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama server base URL for API requests."
        },
        "jarvis.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for OpenAI-compatible custom providers."
        },
        "jarvis.azureEndpoint": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI endpoint URL."
        },
        "jarvis.azureDeployment": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI deployment name."
        },
        "jarvis.azureApiVersion": {
          "type": "string",
          "default": "2024-02-15-preview",
          "description": "Azure OpenAI API version."
        },
        "jarvis.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for Ollama responses."
        },
        "jarvis.maxTokens": {
          "type": "number",
          "default": 512,
          "minimum": 1,
          "description": "Maximum token count for Ollama responses."
        },
        "jarvis.streaming": {
          "type": "boolean",
          "default": true,
          "description": "Enable streaming responses from Ollama when available."
        },
        "jarvis.indexExcludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional glob patterns Jarvis should exclude while indexing the workspace."
        },
        "jarvis.context.maxTokens": {
          "type": "number",
          "default": 3000,
          "minimum": 256,
          "description": "Maximum estimated context tokens Jarvis may attach to a chat request."
        },
        "jarvis.memoryEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable conversation and workspace memory support."
        },
        "jarvis.maxHistory": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Maximum number of conversation turns kept in history."
        }
      }
    },
    "submenus": [
      {
        "id": "nidhish-jarvis.editorMenu",
        "label": "Jarvis"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "nidhish-jarvis.editorMenu",
          "group": "navigation"
        }
      ],
      "nidhish-jarvis.editorMenu": [
        {
          "command": "nidhish-jarvis.explainSelection",
          "group": "1_ai"
        },
        {
          "command": "nidhish-jarvis.fixSelection",
          "group": "1_ai"
        },
        {
          "command": "nidhish-jarvis.refactorSelection",
          "group": "1_ai"
        },
        {
          "command": "nidhish-jarvis.optimizeSelection",
          "group": "1_ai"
        },
        {
          "command": "nidhish-jarvis.generateTests",
          "group": "2_generate"
        },
        {
          "command": "nidhish-jarvis.generateDocumentation",
          "group": "2_generate"
        },
        {
          "command": "nidhish-jarvis.reviewCode",
          "group": "3_review"
        }
      ],
      "explorer/context": [
        {
          "command": "nidhish-jarvis.indexWorkspace",
          "group": "nidhish-jarvis"
        },
        {
          "command": "nidhish-jarvis.explainProject",
          "group": "nidhish-jarvis"
        }
      ]
    }
  },
  "scripts": {
    "build": "node --check extension.js && node --check assistantCore.js && node --check src/bootstrap.js",
    "lint": "eslint extension.js assistantCore.js src test --ignore-pattern \"**/.vscode-test/**\" --ignore-pattern \"**/node_modules/**\"",
    "package": "vsce package --no-dependencies",
    "pretest": "npm run lint",
    "test": "node ./test/run-tests.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "globals": "^16.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
